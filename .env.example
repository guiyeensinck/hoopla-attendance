# ─── Credenciales de la Slack App (obligatorias) ────────────────────
SLACK_BOT_TOKEN=xoxb-tu-bot-token
SLACK_SIGNING_SECRET=tu-signing-secret

# ─── App ─────────────────────────────────────────────────────────────
# Railway inyecta PORT automáticamente; local usa 3000
PORT=3000
# URL pública de la app (los links de /marcar apuntan acá)
APP_URL=https://tu-dominio.up.railway.app

# ─── Reportes y alertas ──────────────────────────────────────────────
# Canal admin: #nombre o ID (C...). El bot tiene que estar invitado.
REPORT_CHANNEL=#asistencia

# ─── Admins ──────────────────────────────────────────────────────────
# Super admins (IDs de Slack separados por coma). Solo ellos pueden
# nombrar otros admins con `/admin admin @user`.
ADMIN_USER_IDS=U0ABC1DEF2

# ─── Base de datos ───────────────────────────────────────────────────
# En Railway: /data (el volumen persistente). Local: se crea ./data
DB_PATH=/data

# ─── Modo prueba (beta cerrada) ──────────────────────────────────────
# true = la app responde solo a los IDs de SOLO_USER_ID (acepta varios,
# separados por coma). Los mensajes de canal van al DM del primero.
SOLO_MODE=true
SOLO_USER_ID=U0ABC1DEF2,U0OTRO123

# ─── Dashboard web (opcional) ────────────────────────────────────────
# Si se setea, el dashboard pide esta clave (basic auth, cualquier usuario)
DASHBOARD_TOKEN=
